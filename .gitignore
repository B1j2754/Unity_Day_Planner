node_modules/
.DS_Store

# Real student data must never be committed. Spreadsheets dropped at the repo
# root, or anywhere under private/, are ignored. templates/ and tests/fixtures/
# stay tracked because they hold no real data.
/*.csv
/*.xlsx
/*.xls
private/

# Downloaded outputs, wherever they land. They are rebuilt from the inputs.
unity-day_*.csv
unity-day_*.zip

# Spreadsheets anywhere, not just the repo root, in case an export is dropped
# into a subfolder. Negated for the two directories that hold no real data.
*.csv
*.xlsx
*.xls
*.xlsm
*.ods
!templates/**
!tests/fixtures/**
